# Azure OpenAI (used if both are set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# OpenAI (used otherwise)
OPENAI_API_KEY=
# Model names (Azure: deployment names)
AGENT_MODEL=gpt-4o-mini
EVALUATOR_MODEL=
ITEMS_PER_SOURCE=3
# Set to 1 to use canned articles / a fake model with no network or key
DEMO_MODE=0
FAKE_LLM=0
DB_PATH=data/signalwire.db
